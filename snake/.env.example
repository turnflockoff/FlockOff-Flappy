# Copy this file to .env (or set these as real environment variables on your
# host — Render/Railway/Fly all have an "Environment" tab) to turn on the
# premium-skins shop AND the Special Skills shop (they share this config).
# Until ALL THREE are set, both shops show "not configured"
# and the game plays normally with just the 12 free skins — nothing breaks.

# ---- PayPal (Developer Dashboard -> Apps & Credentials -> your app) ----
# Start with PAYPAL_ENV=sandbox and a sandbox app to test the whole purchase
# flow with fake money first. Switch to a LIVE app + PAYPAL_ENV=live only once
# you've verified end-to-end (create order -> pay -> capture -> skin unlocks).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- Supabase (stores completed orders + which browser unlocked which skin) ----
# Project: TurnFlockOFF (qvreiiraoovppuvhjubm) — URL below is already correct.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET — get it from
# Supabase Dashboard -> Project Settings -> API -> service_role key.
# Never put this key in client-side code or commit it to git.
SUPABASE_URL=https://qvreiiraoovppuvhjubm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
